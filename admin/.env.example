# Copy to .env and fill in. Never commit .env.

# Google OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: https://posts.josevu.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Email addresses allowed to log in (comma-separated).
ALLOWED_EMAILS=hoangdung@gmail.com

# Public base URL where the app is reached (the tunnel hostname).
OAUTH_REDIRECT_BASE=https://posts.josevu.com

# Local server bind.
HOST=127.0.0.1
PORT=7331
